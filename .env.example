# Copy this file to a private .env. Never commit .env or put credentials in VITE_ variables.
# Paste the Atlas Drivers connection string here.
MONGODB_URI=
MONGODB_DB=
# Blank MongoDB URI uses a persistent local SQLite demo database.
# Set false before first launch for an empty database instead of fictional contacts.
SEED_DEMO=
# Optional: enables the AI assistant. Without it, a clearly labelled offline helper works.
OPENAI_API_KEY=
OPENAI_MODEL=
# Runs locally by default. Do not expose this single-user app to the public internet.
HOST=
PORT=

# GitHub OAuth is optional only outside production. In production, all values below are required.
# Create an OAuth App and set its callback URL to APP_URL/auth/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Use a high-entropy random value (at least 32 bytes); do not reuse an OAuth client secret.
AUTH_SECRET=
# For this private deployment, set this to shaunaleebrennan.
ALLOWED_GITHUB_LOGIN=
# Public HTTPS origin only, without a trailing path (for example, https://your-service.onrender.com).
APP_URL=
